<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="boundary.PantallaRegistrarResultadoDeRevManual"
            styleClass="background-color">

    <!-- Enlace al archivo CSS: Asume que está en resources/css/easysmos.css -->
    <stylesheets>
        <URL value="@/css/easysmos.css" />
    </stylesheets>

    <!-- TOP: ENCABEZADO (easysmos Brand) -->
    <top>
        <BorderPane styleClass="header-bar">
            <left>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="20"/>
                    </padding>
                    <!-- LOGO: TAMAÑO AUMENTADO a 48x48 -->
                    <ImageView fitHeight="96.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@/img/Logoeasysmos.png" />
                        </image>
                    </ImageView>
                    <Label text="easysmos" styleClass="app-title"/>
                    <Label text="Revisión Manual" styleClass="label-subtitle"/>
                </HBox>
            </left>
            <right>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <padding>
                        <Insets top="10" right="20" bottom="10" left="10"/>
                    </padding>
                    <Label fx:id="txtusername" text="username" styleClass="username-label" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- CENTER: VISTAS (StackPane) -->
    <center>
        <StackPane>

            <!-- Vista inicial: Centrada y con botón primario (Verde) -->
            <VBox fx:id="vistaInicial" spacing="20" alignment="CENTER">
                <Label text="Sistema de Detección y Análisis Sísmico" styleClass="label-main-title"/>
                <Button text="Registrar Resultado de Revisión" onAction="#iniciarCU" styleClass="button-primary"/>
            </VBox>

            <!-- Vista del caso de uso (CU) -->
            <VBox fx:id="vistaCU" spacing="15" visible="false" managed="false">
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>

                <!-- TABLA DE EVENTOS (Paso 6) -->
                <Label text="Eventos Sísmicos Auto-Detectados Pendientes" styleClass="label-subtitle" />
                <TableView fx:id="tablaEventos" onMouseClicked="#tomarSeleccionES" VBox.vgrow="SOMETIMES" styleClass="table-view" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="colFechaHora" text="Fecha-Hora Ocurrencia"/>
                        <TableColumn fx:id="colEpicentro" text="Epicentro (Coord)"/>
                        <TableColumn fx:id="colHipocentro" text="Hipocentro (Coord)"/>
                        <TableColumn fx:id="colMagnitud" text="Magnitud"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- DETALLES Y SISMOGRAMA (Paso 9) -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <!-- Columna Izquierda: Detalles y Opciones -->
                    <VBox spacing="15" prefWidth="400" HBox.hgrow="SOMETIMES" styleClass="card-panel">
                        <Label text="Detalles del Evento Sísmico" styleClass="label-subtitle"/>

                        <VBox spacing="5">
                            <Label text="Evento Seleccionado:"/>
                            <TextField fx:id="txtEventoSeleccionado" editable="false" styleClass="text-field" promptText="Fecha y Hora"/>
                        </VBox>

                        <!-- GRID para Alcance, Clasificación, Origen -->
                        <GridPane hgap="10" vgap="10">
                            <Label text="Alcance (km)" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="color-text"/>
                            <TextField fx:id="txtAlcance" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false" styleClass="text-field"/>

                            <Label text="Clasificación" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="color-text"/>
                            <TextField fx:id="txtClasificacion" GridPane.rowIndex="1" GridPane.columnIndex="1" editable="false" styleClass="text-field"/>

                            <Label text="Origen" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="color-text"/>
                            <TextField fx:id="txtOrigen" GridPane.rowIndex="2" GridPane.columnIndex="1" editable="false" styleClass="text-field"/>
                        </GridPane>

                        <Separator />

                        <!-- Botones de Opciones Secundarias (Azul neutro) -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Ver Mapa Sísmico" onAction="#tomarOptMapaSismico" styleClass="button-secondary"/>
                            <Button text="Modificar Datos" onAction="#tomarOptModificarDatos" styleClass="button-secondary"/>
                        </HBox>

                    </VBox>

                    <!-- Columna Derecha: Sismograma -->
                    <VBox HBox.hgrow="ALWAYS" alignment="TOP_CENTER" spacing="10" styleClass="card-panel">
                        <Label text="Sismograma Asociado" styleClass="label-subtitle"/>
                        <ImageView fx:id="imagenSismograma" fitWidth="600" fitHeight="350" preserveRatio="true" />
                        <Label text="(El gráfico se cargará al seleccionar un evento)" styleClass="username-label"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>

    <!-- BOTTOM: ACCIONES FINALES (Paso 14) -->
    <bottom>
        <!-- Fondo ajustado al color suave -->
        <HBox fx:id="seccionBottom" spacing="15" alignment="CENTER_RIGHT" visible="false" managed="false" style="-fx-background-color: #EAF8F9;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Seleccione la Acción Final:" styleClass="label-subtitle" />
            <Region HBox.hgrow="ALWAYS" />

            <!-- Botón Primario: Confirmar -> VERDE -->
            <Button text="Confirmar Evento (Aprobación)" onAction="#confirmarEvento" styleClass="button-primary"/>

            <!-- Botón Rechazar -> ROJO -->
            <Button text="Rechazar Evento" onAction="#rechazarEvento" styleClass="button-danger"/>

            <!-- Botón Derivar a Experto -> AZUL NEUTRO (Secundario) -->
            <Button text="Derivar a Experto" onAction="#derivarEvento" styleClass="button-secondary"/>

            <!-- Botón de Cancelar -> GRIS SUAVE (Cancel) -->
            <Button text="Cancelar Operación" onAction="#cancelarAccion" styleClass="button-cancel"/>
        </HBox>
    </bottom>
</BorderPane>