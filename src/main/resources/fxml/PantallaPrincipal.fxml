<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="boundary.PantallaRegistrarResultadoDeRevManual">

    <!-- SECCIÓN SUPERIOR: TÍTULO Y USUARIO -->
    <top>
        <BorderPane prefHeight="66.0" style="-fx-background-color: #d3baba;">
            <left>
                <VBox alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10"/>
                    </padding>
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Revisión Manual"/>
                </VBox>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <padding>
                        <Insets bottom="10" left="10" right="15" top="10"/>
                    </padding>
                    <Label fx:id="txtusername" text="username"/>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- SECCIÓN CENTRAL: CONTENIDO PRINCIPAL -->
    <center>
        <StackPane fx:id="contenedorCentral">
            <!-- Vista inicial con el botón para empezar -->
            <VBox fx:id="vistaInicial" alignment="CENTER" spacing="20">
                <Label style="-fx-font-size: 18px;" text="Bienvenido al sistema de revisión manual"/>
                <Button onAction="#iniciarCU" text="Registrar Resultado"/>
            </VBox>

            <!-- Vista principal del caso de uso (inicialmente oculta) -->
            <VBox fx:id="vistaCU" managed="false" spacing="15" visible="false">
                <padding>
                    <Insets bottom="15" left="15" right="15" top="15"/>
                </padding>

                <Label style="-fx-font-size: 16px;" text="Últimos eventos sísmicos auto-detectados"/>
                <TableView fx:id="tablaEventos" onMouseClicked="#tomarSeleccionES">
                    <columns>
                        <TableColumn fx:id="colFechaHora" text="Fecha-Hora ocurrencia"/>
                        <TableColumn fx:id="colEpicentro" text="Epicentro"/>
                        <TableColumn fx:id="colHipocentro" text="Hipocentro"/>
                        <TableColumn fx:id="colMagnitud" text="Magnitud"/>
                    </columns>
                </TableView>

                <HBox fx:id="panelDetalles" spacing="20">
                    <VBox spacing="10">
                        <Label text="Evento Sísmico Seleccionado:"/>
                        <TextField fx:id="txtEventoSeleccionado" editable="false"/>
                        <GridPane hgap="10" vgap="10">
                            <Label text="Parámetro" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label text="Valor" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Alcance" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtAlcance" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Clasificación" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <TextField fx:id="txtClasificacion" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label text="Origen" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="txtOrigen" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </GridPane>
                        <Button onAction="#tomarOptMapaSismico" text="Ver mapa sísmico"/>
                        <Button onAction="#tomarOptModificarDatos" text="Modificar Datos"/>
                    </VBox>
                    <ImageView fx:id="imagenSismograma" fitHeight="300" fitWidth="500" preserveRatio="true"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

    <!-- SECCIÓN INFERIOR: BOTONES DE ACCIÓN -->
    <bottom>
        <HBox fx:id="seccionBottom" alignment="CENTER" managed="false" spacing="15" visible="false">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
            <Button onAction="#confirmarEvento" text="Confirmar"/>
            <Button onAction="#rechazarEvento" text="Rechazar"/>
            <Button onAction="#derivarEvento" text="Derivar a experto"/>
            <Button onAction="#cancelarAccion" text="Cancelar"/>
        </HBox>
    </bottom>
</BorderPane>